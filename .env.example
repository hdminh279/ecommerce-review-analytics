# ==========================================
# MinIO / S3 Storage Credentials & Endpoints
# ==========================================
ACCESS_KEY=your_minio_access_key
SECRET_KEY=your_minio_secret_key

# Local development endpoint
MINIO_API_HOST="http://localhost:9000"

# Docker container endpoint
MINIO_ENDPOINT="http://minio:9000"

# ==========================================
# Data Lake S3 Buckets & Layer Paths
# ==========================================
S3_BUCKET='amazon-reviews-datalake'
URL_S3_BRONZE='s3a://amazon-reviews-datalake/bronze'
URL_S3_SILVER='s3a://amazon-reviews-datalake/silver'
URL_S3_GOLD='s3a://amazon-reviews-datalake/gold'
MODEL_SAVE='s3a://amazon-reviews-datalake/silver/model'

# ==========================================
# Optional External API Keys (LLM / Groq)
# ==========================================
API_KEY='your_api_key_here'
